---
import Layout from '../layouts/Layout.astro'

/* ------------------------------------------------------------------
   EDIT HERE. All copy, numbers, names and quotes below are PLACEHOLDERS.
   Replace them with real material before launch.
------------------------------------------------------------------- */
const site = {
  name: 'optflow',
  email: 'hello@optflow.studio',
  phone: '+00 000 000 000',
  address: 'Your street, Your city',
  // Point this at your form service (Formspree, Netlify, Resend...). Empty = demo mode.
  formEndpoint: '',
}

const nav = [
  ['Services', '#services'],
  ['Results', '#results'],
  ['Process', '#process'],
  ['Contact', '#contact'],
]

const services = [
  {
    name: 'Web design',
    benefit: 'A site that looks the part and turns visitors into enquiries.',
    icon: '<rect x="3" y="4" width="18" height="13" rx="2"/><path d="M3 9h18M8 21h8M12 17v4"/>',
  },
  {
    name: 'SEO',
    benefit: 'Show up when customers search, and keep showing up.',
    icon: '<circle cx="11" cy="11" r="7"/><path d="m20 20-3.6-3.6M8 12l2-2 2 1.5 2-3"/>',
  },
  {
    name: 'Performance',
    benefit: 'Pages that load in a blink, so nobody leaves waiting.',
    icon: '<path d="M13 2 4 14h7l-1 8 9-12h-7z"/>',
  },
  {
    name: 'Brand identity',
    benefit: 'A look and a voice people remember and trust.',
    icon: '<circle cx="7.5" cy="7.5" r="4.5"/><rect x="13" y="13" width="8" height="8" rx="1.5"/><path d="m7.5 14 4 7h-8z"/>',
  },
]

const stats = [
  { to: 150, prefix: '+', suffix: '%', label: 'organic traffic, typical in six months' },
  { to: 50, prefix: '', suffix: '+', label: 'businesses served' },
  { to: 3, prefix: '', suffix: 'x', label: 'average return on spend' },
  { to: 98, prefix: '', suffix: '', label: 'average speed score' },
]

const cases = [
  {
    client: 'Client name',
    kind: 'Local services',
    challenge: 'Customers could not find them online.',
    outcome: '+180% enquiries',
  },
  {
    client: 'Client name',
    kind: 'Online shop',
    challenge: 'A slow site was losing sales at checkout.',
    outcome: '2.4s faster loads',
  },
  {
    client: 'Client name',
    kind: 'Start-up',
    challenge: 'A new brand with no audience and no site.',
    outcome: '10k visits in 90 days',
  },
]

const steps = [
  ['Discover', 'We learn your business, your customers and what success looks like.'],
  ['Strategy', 'A clear plan for the pages, words and searches that matter most.'],
  ['Execute', 'We design, build and launch, with you in the loop at every step.'],
  ['Grow', 'We measure, improve and keep your results climbing.'],
]

const quotes = [
  { q: 'They made our site faster and our phone ring more. Simple as that.', name: 'Alex Morgan', co: 'Founder, Northfield' },
  { q: 'Clear, calm and quick. We always knew what was happening next.', name: 'Sam Rivera', co: 'Owner, Kiln & Co' },
  { q: 'Our new brand finally looks like the business we have become.', name: 'Jordan Lee', co: 'Director, Harbor' },
]

const logos = ['Northfield', 'Brightside', 'Kiln & Co', 'Harbor', 'Oakline', 'Lumen']

const initials = (n: string) => n.split(' ').map((p) => p[0]).join('')

// hero graphic: parallel flow lines, one in the accent colour
const flowLines = Array.from({ length: 11 }, (_, i) => i)
---

<Layout>
  <a class="skip" href="#main">Skip to content</a>

  <header class="header" id="top">
    <div class="wrap header-in">
      <a href="#top" class="logo" aria-label={`${site.name} home`}>
        <svg class="logo-mark" viewBox="0 0 26 26" aria-hidden="true">
          <rect width="26" height="26" rx="7" fill="#e8480c"></rect>
          <path d="M5 17c5 0 5-8 10-8s3 8 6 0" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round"></path>
        </svg>
        {site.name}
      </a>
      <nav class="nav-links" id="menu" aria-label="Main">
        {nav.map(([label, href]) => <a href={href}>{label}</a>)}
      </nav>
      <div class="nav-right">
        <a href="#contact" class="btn btn-primary nav-cta">Get in touch</a>
        <button class="menu-btn" type="button" aria-expanded="false" aria-controls="menu" aria-label="Menu">
          <svg class="bars" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
          <svg class="x" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18"></path></svg>
        </button>
      </div>
    </div>
  </header>

  <main id="main">
    <section class="hero" aria-labelledby="hero-title">
      <svg class="flow" viewBox="0 0 900 600" aria-hidden="true" focusable="false">
        {flowLines.map((i) => (
          <path
            class={i === 6 ? 'hot' : ''}
            style={`--i:${i}`}
            pathLength="1"
            d="M-60 420 C 140 420, 230 150, 430 190 S 740 470, 960 300"
            transform={`translate(0 ${(i - 5) * 26})`}
          ></path>
        ))}
      </svg>
      <div class="wrap">
        <h1 id="hero-title">Websites people <em>find</em>, and choose.</h1>
        <p class="lead">We design and build fast, search-ready sites that bring you more customers.</p>
        <div class="hero-actions">
          <a href="#contact" class="btn btn-primary">
            Book a free call
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
          </a>
          <a href="#results" class="btn btn-ghost">See our work</a>
        </div>
      </div>
    </section>

    <section class="section about" aria-label="About">
      <div class="wrap reveal">
        <p>
          We are a small design studio for businesses that want to be found online.{' '}
          <span>We start with your customers, build something fast and clear, and keep improving it until it brings in work.</span>
        </p>
      </div>
    </section>

    <section class="section" id="services" aria-labelledby="services-title">
      <div class="wrap">
        <div class="section-head reveal">
          <h2 id="services-title">Everything you need to get found.</h2>
        </div>
        <ul class="services">
          {services.map((s, i) => (
            <li class="service reveal" style={`--i:${i}`}>
              <span class="service-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" set:html={s.icon}></svg>
              </span>
              <h3>{s.name}</h3>
              <p>{s.benefit}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="section" id="results" aria-labelledby="results-title">
      <div class="wrap">
        <div class="section-head reveal">
          <h2 id="results-title">Results we deliver.</h2>
        </div>
        <ul class="stats">
          {stats.map((s, i) => (
            <li class="stat reveal" style={`--i:${i}`}>
              <b data-count={s.to} data-prefix={s.prefix} data-suffix={s.suffix}>{s.prefix}{s.to}{s.suffix}</b>
              <span>{s.label}</span>
            </li>
          ))}
        </ul>
        <p class="sample-note">Sample figures. Replace with your real results.</p>
        <div class="cases">
          {cases.map((c, i) => (
            <article class="case reveal" style={`--i:${i}`}>
              <div class="case-top">
                <h3>{c.client}</h3>
                <p>{c.kind}</p>
              </div>
              <dl>
                <div>
                  <dt>The challenge</dt>
                  <dd>{c.challenge}</dd>
                </div>
              </dl>
              <p class="outcome">{c.outcome}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section" id="process" aria-labelledby="process-title">
      <div class="wrap">
        <div class="section-head reveal">
          <h2 id="process-title">Simple from first call to growth.</h2>
        </div>
        <ol class="steps">
          {steps.map(([name, text], i) => (
            <li class="step reveal" style={`--i:${i}`}>
              <span class="step-n">{i + 1}</span>
              <h3>{name}</h3>
              <p>{text}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="section" aria-labelledby="proof-title">
      <div class="wrap">
        <div class="section-head reveal">
          <h2 id="proof-title">Clients who came back for more.</h2>
        </div>
        <div class="quotes">
          {quotes.map((x, i) => (
            <figure class="quote reveal" style={`--i:${i}`}>
              <blockquote>“{x.q}”</blockquote>
              <figcaption>
                <span class="avatar" aria-hidden="true">{initials(x.name)}</span>
                <span><b>{x.name}</b><span>{x.co}</span></span>
              </figcaption>
            </figure>
          ))}
        </div>
        <ul class="logos reveal" aria-label="Clients">
          {logos.map((l) => <li>{l}</li>)}
        </ul>
      </div>
    </section>

    <section class="contact" id="contact" aria-labelledby="contact-title">
      <div class="wrap contact-grid">
        <div class="reveal">
          <h2 id="contact-title">Ready to grow?</h2>
          <p class="lead">Tell us about your business. We reply within one working day.</p>
          <a class="contact-mail" href={`mailto:${site.email}`}>{site.email}</a>
        </div>
        <form class="form reveal" id="contact-form" novalidate data-endpoint={site.formEndpoint} style="--i:1">
          <div class="field">
            <label for="f-name">Name</label>
            <input id="f-name" name="name" type="text" autocomplete="name" required placeholder="Your name" aria-describedby="e-name" />
            <span class="err" id="e-name" aria-live="polite"></span>
          </div>
          <div class="field">
            <label for="f-email">Email</label>
            <input id="f-email" name="email" type="email" autocomplete="email" required placeholder="you@company.com" aria-describedby="e-email" />
            <span class="err" id="e-email" aria-live="polite"></span>
          </div>
          <div class="field full">
            <label for="f-msg">How can we help?</label>
            <textarea id="f-msg" name="message" required placeholder="A few lines about your business and goals" aria-describedby="e-msg"></textarea>
            <span class="err" id="e-msg" aria-live="polite"></span>
          </div>
          <input class="hp" type="text" name="company" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <div class="form-foot">
            <button class="btn btn-primary" type="submit" id="submit">
              Book a free call
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
            </button>
            <p class="form-status" id="status" role="status"></p>
          </div>
        </form>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="wrap">
      <div class="footer-grid">
        <div class="footer-about">
          <a href="#top" class="logo">
            <svg class="logo-mark" viewBox="0 0 26 26" aria-hidden="true">
              <rect width="26" height="26" rx="7" fill="#e8480c"></rect>
              <path d="M5 17c5 0 5-8 10-8s3 8 6 0" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round"></path>
            </svg>
            {site.name}
          </a>
          <p>Design-led websites and brands that get found.</p>
        </div>
        <div>
          <h3>Explore</h3>
          <ul>{nav.map(([label, href]) => <li><a href={href}>{label}</a></li>)}</ul>
        </div>
        <div>
          <h3>Contact</h3>
          <ul>
            <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
            <li><a href={`tel:${site.phone.replace(/\s/g, '')}`}>{site.phone}</a></li>
            <li>{site.address}</li>
          </ul>
        </div>
        <div>
          <h3>Follow</h3>
          <div class="social">
            <a href="#" aria-label="LinkedIn"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z"></path><rect width="4" height="12" x="2" y="9"></rect><circle cx="4" cy="4" r="2"></circle></svg></a>
            <a href="#" aria-label="X"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4l11.7 16H20L8.3 4z"></path><path d="M4 20l6.8-6.8m2.5-2.5L20 4"></path></svg></a>
            <a href="#" aria-label="Instagram"><svg viewBox="0 0 24 24" aria-hidden="true"><rect width="20" height="20" x="2" y="2" rx="5"></rect><path d="M16 11.4A4 4 0 1 1 12.6 8 4 4 0 0 1 16 11.4z"></path><path d="M17.5 6.5h.01"></path></svg></a>
          </div>
        </div>
      </div>
      <p class="legal">© 2026 Optflow. All rights reserved.</p>
    </div>
  </footer>

  <script>
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches

    // header: border on scroll + mobile menu
    const header = document.querySelector<HTMLElement>('.header')!
    const btn = header.querySelector<HTMLButtonElement>('.menu-btn')!
    const setOpen = (open: boolean) => {
      header.toggleAttribute('data-open', open)
      btn.setAttribute('aria-expanded', String(open))
    }
    btn.addEventListener('click', () => setOpen(!header.hasAttribute('data-open')))
    header.querySelectorAll('#menu a').forEach((a) => a.addEventListener('click', () => setOpen(false)))
    document.addEventListener('keydown', (e) => e.key === 'Escape' && setOpen(false))
    const onScroll = () => header.classList.toggle('scrolled', scrollY > 8)
    onScroll()
    addEventListener('scroll', onScroll, { passive: true })

    // reveal on scroll
    const reveals = document.querySelectorAll('.reveal')
    if (reduce || !('IntersectionObserver' in window)) {
      reveals.forEach((el) => el.classList.add('in'))
    } else {
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((en) => {
            if (en.isIntersecting) {
              en.target.classList.add('in')
              io.unobserve(en.target)
            }
          })
        },
        { threshold: 0.12, rootMargin: '0px 0px -6% 0px' },
      )
      reveals.forEach((el) => io.observe(el))
    }

    // stat count-up
    const counters = document.querySelectorAll<HTMLElement>('[data-count]')
    const run = (el: HTMLElement) => {
      const to = Number(el.dataset.count)
      const pre = el.dataset.prefix ?? ''
      const suf = el.dataset.suffix ?? ''
      const t0 = performance.now()
      const dur = 1400
      const tick = (t: number) => {
        const p = Math.min((t - t0) / dur, 1)
        const e = p === 1 ? 1 : 1 - Math.pow(2, -10 * p)
        el.textContent = `${pre}${Math.round(to * e)}${suf}`
        if (p < 1) requestAnimationFrame(tick)
      }
      requestAnimationFrame(tick)
    }
    if (!reduce && 'IntersectionObserver' in window) {
      const co = new IntersectionObserver(
        (entries) => {
          entries.forEach((en) => {
            if (en.isIntersecting) {
              run(en.target as HTMLElement)
              co.unobserve(en.target)
            }
          })
        },
        { threshold: 0.6 },
      )
      counters.forEach((c) => co.observe(c))
    }

    // contact form
    const form = document.querySelector<HTMLFormElement>('#contact-form')!
    const submit = document.querySelector<HTMLButtonElement>('#submit')!
    const status = document.querySelector<HTMLElement>('#status')!
    const rules: Record<string, (v: string) => string> = {
      name: (v) => (v.trim() ? '' : 'Please tell us your name.'),
      email: (v) =>
        /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v.trim()) ? '' : 'Enter a valid email, like you@company.com.',
      message: (v) => (v.trim().length >= 10 ? '' : 'Add a few words about what you need.'),
    }
    const idFor: Record<string, string> = { name: 'e-name', email: 'e-email', message: 'e-msg' }
    const check = (name: string) => {
      const field = form.elements.namedItem(name) as HTMLInputElement
      const msg = rules[name](field.value)
      document.getElementById(idFor[name])!.textContent = msg
      field.setAttribute('aria-invalid', String(Boolean(msg)))
      return !msg
    }
    Object.keys(rules).forEach((n) => {
      const f = form.elements.namedItem(n) as HTMLInputElement
      f.addEventListener('blur', () => check(n))
      f.addEventListener('input', () => f.getAttribute('aria-invalid') === 'true' && check(n))
    })
    form.addEventListener('submit', async (e) => {
      e.preventDefault()
      status.className = 'form-status'
      status.textContent = ''
      const bad = Object.keys(rules).filter((n) => !check(n))
      if (bad.length) {
        ;(form.elements.namedItem(bad[0]) as HTMLElement).focus()
        return
      }
      const data = new FormData(form)
      if (data.get('company')) return // honeypot
      submit.disabled = true
      status.textContent = 'Sending…'
      try {
        const endpoint = form.dataset.endpoint
        if (endpoint) {
          const res = await fetch(endpoint, {
            method: 'POST',
            body: data,
            headers: { Accept: 'application/json' },
          })
          if (!res.ok) throw new Error('bad response')
        } else {
          await new Promise((r) => setTimeout(r, 700)) // demo mode
        }
        form.reset()
        status.className = 'form-status ok'
        status.textContent = 'Thanks! We will reply within one working day.'
      } catch {
        status.className = 'form-status bad'
        status.textContent = 'Something went wrong. Please try again or email us directly.'
      } finally {
        submit.disabled = false
      }
    })
  </script>
</Layout>
