---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Optflow — Web Design, Custom Development & SEO Agency</title>
    <meta
      name="description"
      content="Optflow builds high-converting, SEO-optimized websites and digital experiences for real estate, interior design, and premium brands."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600&family=Geist+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="nav">
      <a href="#top" class="logo">
        <span class="logo-mark"></span>optflow
      </a>
      <nav>
        {nav.map(([l, h]) => (
          <a href={h}>{l}</a>
        ))}
      </nav>
      <a href="#contact" class="btn btn-dark">
        Book a strategy call
      </a>
    </header>

    <main id="top">
      <!-- HERO -->
      <section class="hero">
        <div class="hero-bg" id="hero-bg" aria-hidden="true"></div>
        <h1 class="hero-title">
          We design, build &amp; optimize
          <br />
          <span class="hl">High-Converting Search Engines.</span>
        </h1>
        <div class="hero-foot">
          <p>
            Crafting bespoke brand identities, fast custom websites, and
            targeted local SEO strategies for real estate, interior design, and
            high-ticket service businesses.
          </p>
          <button class="mono copy" id="copy" data-email="hello@optflow.studio">
            <span>
              hello@<b>optflow.studio</b>
            </span>
          </button>
        </div>
      </section>

      <!-- CLIENTS -->
      <section class="clients">
        <p class="eyebrow">
          Trusted by ambitious real estate &amp; design brands
        </p>
        <div class="marquee">
          <div class="track">
            {[0, 1].map(() =>
              clients.map((c) => <span class="client">{c}</span>),
            )}
          </div>
        </div>
      </section>

      <!-- WORK -->
      <section class="section" id="work">
        <div class="head reveal">
          <div>
            <p class="eyebrow">Selected concept studies &amp; work</p>
            <h2>High-performance web platforms designed for organic growth</h2>
          </div>
          <a href="#contact" class="btn btn-light">
            Book a discovery call
          </a>
        </div>
        <div class="work-grid">
          {projects.map((p, i) => (
            <article
              class="card reveal"
              style={`--a:${p.a};--b:${p.b};--c:${p.c}`}
            >
              <div class="art">
                <>
                  <span class="art-shape s1" />
                  <span class="art-shape s2" />
                  <span class="art-num mono">0{i + 1}</span>
                </>
              </div>
              <div class="card-body">
                <h3>{p.name}</h3>
                <p>{p.desc}</p>
                <ul class="tags">
                  {p.tags.map((t) => (
                    <li>{t}</li>
                  ))}
                </ul>
              </div>
            </article>
          ))}
        </div>
      </section>

      <!-- SERVICES -->
      <section class="section" id="services">
        <div class="head reveal">
          <div>
            <p class="eyebrow">End-to-End Capabilities</p>
            <h2>
              Everything your digital presence needs to convert &amp; rank
            </h2>
          </div>
        </div>
        <ul class="services">
          {services.map((s) => (
            <li class="service reveal">
              <span class="mono num">{s.n}</span>
              <h3>{s.title}</h3>
              <div class="svc-detail">
                <p>{s.desc}</p>
                <ul class="tags">
                  {s.tags.map((t) => (
                    <li>{t}</li>
                  ))}
                </ul>
              </div>
            </li>
          ))}
        </ul>
      </section>

      <!-- PROCESS -->
      <section class="section">
        <div class="head reveal">
          <div>
            <p class="eyebrow">Our methodology</p>
            <h2>
              From concept to <em>search dominance</em> in 3 steps
            </h2>
          </div>
        </div>
        <div class="steps">
          {steps.map(([t, d], i) => (
            <div class="step reveal">
              <>
                <span class="mono">0{i + 1}</span>
                <h3>{t}</h3>
                <p>{d}</p>
              </>
            </div>
          ))}
        </div>
      </section>

      <!-- PRICING -->
      <section class="section" id="pricing">
        <div class="head reveal">
          <div>
            <p class="eyebrow">Transparent Investment</p>
            <h2>Tailored packages designed for clear business ROI</h2>
          </div>
        </div>
        <div class="work-grid">
          {plans.map((p) => (
            <div
              class={`card reveal ${p.featured ? "featured" : ""}`}
              style="padding: 2.5rem; display: flex; flex-direction: column; justify-content: space-between; border: 1px solid rgba(255,255,255,0.1); border-radius: 12px; background: rgba(255,255,255,0.02);"
            >
              <div>
                <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 1rem;">
                  <h3 style="font-size: 1.5rem; font-weight: 500;">{p.name}</h3>
                  <div class="mono" style="font-size: 1.25rem;">
                    <b>{p.price}</b>{" "}
                    <small style="opacity: 0.6; font-size: 0.8rem;">
                      {p.unit}
                    </small>
                  </div>
                </div>
                <p style="opacity: 0.8; margin-bottom: 1.5rem; line-height: 1.5;">
                  {p.blurb}
                </p>
                <ul style="list-style: none; padding: 0; margin-bottom: 2rem;">
                  {p.items.map((item) => (
                    <li style="padding: 0.4rem 0; opacity: 0.85; font-size: 0.95rem; display: flex; align-items: center; gap: 0.5rem;">
                      <span style="color: #0fb880;">✓</span> {item}
                    </li>
                  ))}
                </ul>
              </div>
              <a
                href="#contact"
                class={`btn ${p.featured ? "btn-light" : "btn-dark"}`}
                style="text-align: center; width: 100%;"
              >
                Select {p.name}
              </a>
            </div>
          ))}
        </div>
      </section>

      <!-- TESTIMONIALS + STATS -->
      <section class="section">
        <div class="head reveal">
          <div>
            <p class="eyebrow">Client results</p>
            <h2>
              Transforming local visibility into consistent organic pipelines
            </h2>
          </div>
        </div>
        <div class="quotes">
          {quotes.map(([q, n, r]) => (
            <figure class="quote reveal">
              <>
                <blockquote>{q}</blockquote>
                <figcaption>
                  <>
                    <b>{n}</b>
                    <span>{r}</span>
                  </>
                </figcaption>
              </>
            </figure>
          ))}
        </div>
        <div class="stats">
          {stats.map(([n, s, l]) => (
            <div class="stat reveal">
              <>
                <b>
                  <span data-count={n}>0</span>
                  {s}
                </b>
                <span>{l}</span>
              </>
            </div>
          ))}
        </div>
      </section>

      <!-- JOURNAL -->
      <section class="section" id="journal">
        <div class="head reveal">
          <div>
            <p class="eyebrow">Insights &amp; Strategy</p>
            <h2>Articles on web design, performance &amp; organic search</h2>
          </div>
          <a href="#journal" class="btn btn-light">
            View all articles
          </a>
        </div>
        <div class="posts">
          {posts.map(([date, cat, title, desc, a, b]) => (
            <a href="#journal" class="post reveal">
              <div class="post-art" style={`--a:${a};--b:${b}`} />
              <div class="meta mono">
                <>
                  <span>{date}</span>
                  <span class="pill">{cat}</span>
                </>
              </div>
              <h3>{title}</h3>
              <p>{desc}</p>
            </a>
          ))}
        </div>
      </section>

      <!-- FAQ -->
      <section class="section faq-wrap" id="faq">
        <div class="head reveal">
          <div>
            <p class="eyebrow">Frequently Asked Questions</p>
            <h2>Everything you need to know about our process</h2>
          </div>
        </div>
        <div class="faq">
          {faqs.map(([q, a], i) => (
            <details class="reveal" open={i === 0}>
              <summary>
                <span class="mono">{i + 1}</span>
                {q}
                <i />
              </summary>
              <p>{a}</p>
            </details>
          ))}
        </div>
      </section>

      <!-- CTA -->
      <section class="cta" id="contact">
        <p class="eyebrow">Ready to grow your search visibility?</p>
        <h2>Let's build a website that drives real business results.</h2>
        <a href="mailto:hello@optflow.studio" class="btn btn-dark btn-lg">
          Book a strategy call
        </a>
      </section>
    </main>

    <footer class="footer">
      <a href="#top" class="logo">
        <span class="logo-mark"></span>optflow
      </a>
      <nav>
        <a href="#">X (Twitter)</a>
        <a href="#">LinkedIn</a>
        <a href="#">Behance</a>
        <a href="#">Dribbble</a>
      </nav>
      <small>© 2026 Optflow Studio. All rights reserved.</small>
    </footer>

    <script>
      import Lenis from "lenis";
      import { initPixelCloud } from "../scripts/pixel-cloud";

      // hero background
      const heroBg = document.getElementById("hero-bg");
      if (heroBg)
        initPixelCloud(heroBg, {
          skyTopColor: "#5f93e3",
          skyBottomColor: "#b4cdf4",
          cloudColor: "#F4F4F1",
        });

      // smooth scroll
      if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
        const lenis = new Lenis({ lerp: 0.09, anchors: { offset: -80 } });
        const raf = (t: number) => {
          lenis.raf(t);
          requestAnimationFrame(raf);
        };
        requestAnimationFrame(raf);
      }

      // clock
      const clock = document.getElementById("clock");
      const tick = () => {
        if (clock)
          clock.textContent = new Date().toLocaleTimeString("en-GB", {
            hour: "2-digit",
            minute: "2-digit",
            timeZone: "UTC",
          });
      };
      tick();
      setInterval(tick, 15000);

      // copy email
      const copy = document.getElementById("copy");
      copy?.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(copy.dataset.email ?? "");
          const span = copy.querySelector("span")!;
          const old = span.innerHTML;
          span.textContent = "Copied!";
          setTimeout(() => (span.innerHTML = old), 1400);
        } catch {}
      });

      // reveal + counters
      const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
      const io = new IntersectionObserver(
        (entries) =>
          entries.forEach((e) => {
            if (!e.isIntersecting) return;
            e.target.classList.add("in");
            e.target
              .querySelectorAll<HTMLElement>("[data-count]")
              .forEach((el) => {
                const to = Number(el.dataset.count);
                if (reduce) return void (el.textContent = String(to));
                const t0 = performance.now();
                const step = (t: number) => {
                  const p = Math.min((t - t0) / 1400, 1);
                  el.textContent = String(
                    Math.round(to * (1 - Math.pow(1 - p, 3))),
                  );
                  if (p < 1) requestAnimationFrame(step);
                };
                requestAnimationFrame(step);
              });
            io.unobserve(e.target);
          }),
        { threshold: 0.15 },
      );
      document.querySelectorAll(".reveal").forEach((el) => io.observe(el));
    </script>
  </body>
</html>
